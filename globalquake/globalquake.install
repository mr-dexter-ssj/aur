# Based on aur/jquake by Benoit <archlinux@benoit.jp.net>

post_install() {
  echo "Sound: on PipeWire or PulseAudio systems, install pipewire-alsa or"
  echo "pulseaudio-alsa (Java outputs through ALSA). GlobalQuake always plays on"
  echo "the system default audio device."
}

post_upgrade() {
  post_install
}